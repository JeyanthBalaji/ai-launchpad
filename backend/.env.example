# Copy this file to `.env` and fill in your key at hackathon kickoff.
# Fireworks AI gives you an API key + free credits during the AMD hackathon.

FIREWORKS_API_KEY=your_fireworks_api_key_here

# Model to use for the agents. This is a good default open model on Fireworks.
# You can swap it for another model listed in the Fireworks dashboard.
FIREWORKS_MODEL=accounts/fireworks/models/llama-v3p1-8b-instruct

# Base URL for the Fireworks OpenAI-compatible endpoint.
FIREWORKS_BASE_URL=https://api.fireworks.ai/inference/v1
