# Copy this file to `.env` and fill in your values.
# AI Launchpad runs its agents on AMD compute. Two supported backends,
# both OpenAI-compatible — switch by changing the base URL + model.

# ---------------------------------------------------------------------------
# OPTION A — Fireworks AI (runs open models on AMD GPUs)
# You receive a Fireworks API key + credits during the AMD hackathon.
# Recommended hackathon models: MiniMax (e.g. MiniMax-M3) or Kimi K series.
# ---------------------------------------------------------------------------
FIREWORKS_API_KEY=your_fireworks_api_key_here
FIREWORKS_MODEL=accounts/fireworks/models/minimax-m3
FIREWORKS_BASE_URL=https://api.fireworks.ai/inference/v1

# ---------------------------------------------------------------------------
# OPTION B — AMD Developer Cloud (self-hosted model on an AMD GPU via vLLM)
# On your AMD Developer Cloud instance (notebooks.amd.com/hackathon) run:
#   vllm serve Qwen/Qwen2-7B-Instruct --port 8000 --gpu-memory-utilization 0.3
# Then point the app at that server. vLLM exposes an OpenAI-compatible API,
# so no code changes are needed — just set these three and restart.
#   FIREWORKS_API_KEY=EMPTY
#   FIREWORKS_MODEL=Qwen/Qwen2-7B-Instruct
#   FIREWORKS_BASE_URL=http://<your-amd-cloud-host>:8000/v1

# ---------------------------------------------------------------------------
# Development toggle: USE_MOCK=true serves sample data (no API calls, no key).
# Set to false once your key/endpoint is live.
# ---------------------------------------------------------------------------
USE_MOCK=true
